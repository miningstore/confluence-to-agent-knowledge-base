# {{COMPANY_NAME}} Knowledge Base Configuration
# Generated by confluence-to-kb skill

company_name: "{{COMPANY_NAME}}"
company_description: >
  {{COMPANY_DESCRIPTION}}

confluence:
  url: "{{CONFLUENCE_URL}}"
  email: "${CONFLUENCE_EMAIL}"
  api_token: "${CONFLUENCE_API_TOKEN}"
  cloud_id: "{{CLOUD_ID}}"

spaces:
  include:
{{SPACE_KEYS_YAML}}
  exclude: []
  include_archived: false
  include_personal: false

compile:
  model: "claude-sonnet-4-20250514"
  max_tokens: 4096
  categories:
{{CATEGORIES_YAML}}
  min_content_length: 100
  generate_concepts: true
  generate_backlinks: true

raw_dir: "raw"
wiki_dir: "wiki"
output_dir: "output"
anthropic_api_key: "${ANTHROPIC_API_KEY}"
